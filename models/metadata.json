{
  "model_name": "PhishSight Character N-gram Model",
  "status": "experimental_candidate",
  "algorithm": "TfidfVectorizer character n-grams + LinearSVC",
  "source_dataset": "flwrlabs/fed-phishing-urls",
  "training_sample_size": 250000,
  "actual_model_training_rows": 197240,
  "feature_extraction": {
    "analyzer": "char",
